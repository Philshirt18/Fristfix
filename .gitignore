# Android signing
android/key.properties
*.jks
*.keystore

# Firebase config files (contain API keys - but these are generally safe to commit for Firebase)
# Keeping them in repo as they're needed for builds
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# RevenueCat API key is in source code - acceptable for mobile apps
# as it's a public-facing key (not a secret server key)

# Environment files
.env
*.env
